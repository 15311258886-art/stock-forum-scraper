*.stage0.bak
*.bak

# ── Node 前端依赖 / 构建产物（与后端正确性体系无关）──
node_modules/
dist/
build/

# ── 编辑器 / 系统 ──
.DS_Store
*.swp

# ── 临时探针 / 运行产物（约定：一次性脚本与截图一律 `_` 前缀，不入库）──
# 说明：根目录与 tools/ 下 `_*` 均为调试期一次性产物（探针脚本、中间 json/txt、截图），
#       活代码不引用它们；如以后确要保留某个脚本，请去掉 `_` 前缀正式命名。
_*
# 例外：Python 包的 __init__.py 以 `_` 开头（双下划线），属于活代码，须入库。
!__init__.py
_*.png
_*.json
_*.txt
_*.log
audit_last.png
audit_clickthrough_result.json
audit_data_result.json
e2e_all_tabs_result.json
verify_backend_result*.txt
stage0_mutations.json
auto_update_status.json
moneyflow_negcache.json

# ── 整改 #01：会话 / Cookie / 浏览器 profile / 运行产物，一律不入库 ──
# 背景：浏览器 profile 内含登录态、cookie 文件含明文会话，属泄密面；
#       上一轮清理曾用 `git add -A` 误把它们带进版本库，此处显式排除并已解除跟踪。
.browser-profile/
.workbuddy/
tools/*cookie*.json
tools/*cookie*.txt
artifacts/
shots/
qa_run/*.png
tests/*.png
audit_last.png
shot_judge.png
viewer/app_iso*.db
viewer/app_iso*.db-*
viewer/*.db.bak-*
# 全局拦截图产物，但放行正式图标素材（assets/ 下的 png 仍可正常纳入）
*.png
!assets/**/*.png

# 运行时状态（PID 文件，每次启动都变）
*.pid
viewer/.server.pid

# 启动器（launch_viewer.py）的运行期产物：每次都变，且只对本机那一刻有意义
#   .launcher.lock              单实例锁（首字节锁 + holder PID/时间戳）
#   launcher_status.json        上次启动跑到哪一步（诊断用，见 launch_viewer.py::_stage）
.launcher.lock
viewer/data/launcher_status.json
viewer/data/launcher_status.json.tmp

# ── 运行期 K 线缓存（2026-10-31 盘点：viewer/data/ 下 5,661 个 kline_*.json，合计 2.2 GB）──
# 这些是**可重建**的行情缓存，不是源码。原规则只挡了 `*_cache.json`，
# 而这类文件名是 `kline_<hash>.json`，一条都没被挡住 —— 一次 `git add -A`
# 就会把 2.2 GB 塞进版本库，而且它们每天都变（等于每次提交都是全量 diff）。
viewer/data/kline_*.json
viewer/data/app.db
viewer/data/kbase.db
viewer/data/*.log
data/app.db

# 根目录临时日志（2026-10-31：回测/端口验证/冒烟一次跑一次，会散落一堆）
_bt_*.log
_srv*.log
_smoke.log

# ── 历史版本快照（2026-10-31 纳入版本管理时盘点）──
# viewer/static/ 下有 73 个 `app.js.bak-<标签>-<时间戳>` 快照，合计 40 MB。
# 原规则只挡了 `*.bak` 精确后缀与 `viewer/*.db.bak-*`，带标签的 `*.bak-*` 全部漏网，
# 一次 `git add -A` 就会把几十份重复的前端快照塞进版本库。改为统一后缀拦截。
*.bak-*
*.bak_*
*.bak.*

# ── 模型权重（二进制，可重新下载，不入库）──
# 2026-10-31 盘点：viewer/kronos_core/weights/ 约 31 MB（NeoQuasar/Kronos-mini、Kronos-Tokenizer-base）。
# 代码（kronos.py / module.py）入库，权重走 model_repo.json 描述的外部下载。
viewer/kronos_core/weights/

# ── 运行时可重建数据（2026-10-31 补充）──
# viewer/data/ 合计 2.2 GB，其中 kline_*.json 已被上面的规则挡住；
# 这里再兜底挡住同目录下的中间产物与备份库，避免目录被整体 `git add` 时漏网。
viewer/data/*.db
viewer/data/*.db-*
viewer/data/*.log

# ── 缓存类大文件（2026-10-31 纳入版本管理时盘点）──
# 原规则 `*_cache.json` 只匹配下划线写法，实际文件名是 `*_kcache.json`（无下划线），
# 一条都没挡住：data/decline_kcache.json 32 MB、predict_kcache.json 14 MB。
# 另有 data/*.gz 两个扫描中间包合计 40 MB。均属可重建缓存，不入库。
*_kcache.json
data/*.gz

# ── 历史重写（D59）后需继续挡住的文件 ──
# 这些文件 2026-10-31 前曾被 git 跟踪，已从全部历史中剔除；
# 若不在此显式挡住，一次 `git add -A` 就会把它们重新塞回去（合计约 95 MB，且每天变化）。
# 判定口径：可由程序重新生成、丢失不影响任何决策与回滚能力。
fund_link_result.json
data/bili_scan_*
data/decline_kcache.json
data/*.tmp
.browser-profile/
shots/
artifacts/

