@echo off
chcp 65001 >nul
title 第1步：开始回填数据
echo ====================================================
echo   股票论坛查看器 - 数据回填（双击即跑）
echo ====================================================
echo.
echo [自查 1/2] 检查代理是否已开启...
netstat -an | find "53269" >nul 2>nul
if %errorlevel%==0 (
    echo   [OK] 代理 127.0.0.1:53269 已在运行。
) else (
    echo   [注意] 没检测到代理在 53269 端口运行。
    echo          请先打开你的代理/VPN 软件并确认系统代理已开启，
    echo          否则雪球数据会抓不到（其他网站不受影响）。
    echo          开好后回到本窗口，按任意键继续。
    pause >nul
)
echo.
echo [自查 2/2] 检查 cookie 文件...
if exist "%~dp0cookies.txt" (
    echo   [OK] 已检测到 cookies.txt，组合持仓会一并回填。
) else if exist "%~dp0cookies.json" (
    echo   [OK] 已检测到 cookies.json，组合持仓会一并回填。
) else (
    echo   [提示] 未检测到 cookies.txt —— 不影响本次运行！
    echo          本次会先补「讨论/交易/帖子」数据；
    echo          组合持仓需要先双击「第2步-保存雪球Cookie.bat」，
    echo          存好后再跑一次本文件即可。
)
echo.
echo ====================================================
echo   开始抓取，预计 5-15 分钟（取决于网络）。
echo   中途别关这个黑窗口，跑完会显示总结。
echo ====================================================
echo.
call "%~dp0run_backfill_local.bat"
echo.
echo ====================================================
echo   全部结束。请：
echo   1. 关闭「股票论坛可视化查看器」窗口
echo   2. 重新双击桌面上的「股票论坛可视化查看器」图标
echo   3. 把本窗口日志截图发给 AI 助手
echo ====================================================
pause
