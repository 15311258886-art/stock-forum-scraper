            "bull": v["bull"], "bear": v["bear"], "neutral": v["neu"], "mentions": v["total"],
        })
    map_list.sort(key=lambda x: (x["bull"] + x["bear"], x["mentions"]), reverse=True)
    named = sum(1 for x in map_list if not x["name_missing"])
    return {
        "distribution": dist,
        "map": map_list[:30],
        # 名称解析覆盖率：界面据此提示"是否有代码未识别"
        "name_covered": named,
