        "SELECT id, site, author, post_id, post_url, post_time, action, symbol, symbol_name, "
        "price, quantity, raw_text "
        "FROM trades WHERE action IN ('BUY','SELL','HOLD') ORDER BY post_time DESC LIMIT 200"
    ).fetchall()
    idx = _player_index()
    out = []
