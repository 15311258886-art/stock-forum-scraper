      `href="#${escAttr(c.key)}/${escAttr(items[0].tab)}" title="${escAttr(c.label)}">` +
      `<span class="ni-ico" aria-hidden="true">${esc(c.icon || "")}</span>` +
      `<span class="ni-txt">${esc(c.label)}</span>` +
      `<span class="ni-n">${items.length}</span></a>`;
