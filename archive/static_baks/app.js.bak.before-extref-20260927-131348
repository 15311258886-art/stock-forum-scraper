function hsCard(it, idx) {
  const ev = it.evidence || {};
  const kindBadge = it.judgment
    ? `<span class="badge hs-kind hs-kind-${escAttr(it.kind)}">${hsKindLabel(it.kind)}</span>`
    : `<span class="badge hs-kind hs-nojudge">暂无板块判断</span>`;
