/* 涨跌色：必须用 .bull/.bear —— app.css 里只有这两个是全局红/绿（A 股口径 红涨绿跌）。
   原先这里写的是 .up/.down，而 .up/.down 只对个别元素作用域生效，导致颜色一直没显示出来。*/
function lhbPct(v, d = 2) {
