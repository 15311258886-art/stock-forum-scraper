      <tbody>${sellRows || "<tr><td colspan=5 class='empty'>无</td></tr>"}</tbody></table></div></div>`;
  }

  // ---------- 游资席位榜（以营业部为轴，滚动窗口）----------
  const depts = d.depts_top || [];
  const deptRows = depts.map((x, i) => {
    const on = LHB.selDept === x.operate_name;
