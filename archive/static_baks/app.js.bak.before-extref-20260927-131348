  const cls = has(q.pct) ? (Number(q.pct) >= 0 ? "bull" : "bear") : "";
  const vsPre = (v) => (has(v) && has(q.prev_close)) ? (Number(v) >= Number(q.prev_close) ? "bull" : "bear") : "";
