  });
  $$("#p-lhb_sectors [data-ol-branch]:not([data-ol-sector])").forEach((el) => {
    el.onclick = () => openBranchModal("", el.dataset.olBranch, el.dataset.olDate);
  });
}
function renderPlayers(list) {
