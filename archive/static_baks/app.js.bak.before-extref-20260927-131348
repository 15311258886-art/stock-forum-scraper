      const trades = toArr(d.trades).map((t) =>
        `<div class="box" style="margin-bottom:6px"><div class="t">${actionBadge(t.action)} ${esc(t.symbol)} ${esc(t.symbol_name)}</div><div class="meta">${esc(fmtTimeText(t.post_time))} · 价格 ${t.price ?? "-"} · 数量 ${t.quantity ?? "-"}</div></div>`).join("");
      // 持仓徽章内标注「持仓起始日期」（title 给出完整日期与已持有天数）
      const pos = toArr(d.positions).map((p) => {
        const isSell = (p.action || "").toUpperCase() === "SELL";
        const since = (p.hold_since || "").trim();
        const tip = since ? `持仓起始日期 ${since.slice(0, 10)}${p.hold_days != null ? `，已持有 ${p.hold_days} 天` : ""}` : "起始日期未披露";
        return `<span class="badge ch-${escAttr(p.channel || 'A')}" title="${escAttr(tip)}">${esc(p.symbol)} ${esc(p.symbol_name)} ${p.ratio != null ? p.ratio + '%' : ''}${since ? `<i class="hold-mini">${esc(since.slice(5, 10))} 起</i>` : ""}${isSell ? `<i class="hold-mini sell-mini">已卖出</i>` : ""}</span>`;
      }).join(" ");
      html =
