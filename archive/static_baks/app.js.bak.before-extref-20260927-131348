    <div class="s" style="margin-top:8px">更新时间：${esc(d.updated_at || "—")}。板块归属取自东财 F10 题材库，
      已剔除指数成分与风格 / 行为类板块（如「昨日涨停」「高送转」等统计口径）。</div>
    ${outlookHtml(d.outlook)}`;
  $$("#p-lhb_sectors [data-lhs-date]").forEach((el) => {
