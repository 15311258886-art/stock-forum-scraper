        });
        if (!r || !r.ok) {
          setHint("打开登录窗口失败：" + (r && r.error ? r.error : "未知错误"));
          b.disabled = false; b.textContent = old;
          return;
        }
        setHint("已打开受控登录窗口：请在该窗口里完成登录（扫码要记得点「确认」），" +
                "登录成功后会自动保存。窗口在保存前请不要关闭。");
        b.textContent = "登录中…（等待保存）";
        startLoginPoll(site, b, old);
      } catch (e) {
