/* ================= 策略回测 · 三栏视图（2026-09-26 T04） =================
   颜色一律走既有令牌（不新写色值）；数值方向色复用全局 .bull/.bear/.muted；
   横幅用语义色（黄=注意 / 蓝=提示），**不与涨跌红绿混淆**。 */
.lab-top { margin-bottom: 8px; }
.lab-h2 { margin: 0 0 6px; font-size: 17px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.lab-h2-sub { font-size: 12px; font-weight: 400; color: var(--muted); }
.lab-meta { display: flex; flex-wrap: wrap; gap: 6px; }
.lab-mchip {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 9px; border-radius: 11px; font-size: 12px;
  background: var(--tag); color: var(--text); border: 1px solid var(--border);
}
.lab-mchip b { color: var(--accent); }
.lab-mchip-warn { background: var(--warn-bg); border-color: var(--warn-line); color: var(--warn); }
.lab-mchip-warn b { color: var(--warn); }

/* 常驻口径横幅（不可关）：提示色用蓝，不用红绿 */
.lab-caliber {
  background: var(--c2-bg); border: 1px solid var(--c2-fg); color: var(--c2-fg);
  border-radius: 10px; padding: 8px 12px; font-size: 12.5px; line-height: 1.9; margin-bottom: 10px;
}
