/* ---- 2026-09-26 策略关联基金弹窗（点击策略 → 展示对应公募基金/ETF，逐条标来源） ---- */
.fund-modal { width: min(1060px, 95vw); }
.fund-modal .fm-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
.fund-modal .fm-head h3 { font-size: 17px; font-weight: 700; margin: 0; color: var(--ink, #111); }
.fund-modal .fm-sub { font-size: 12px; color: var(--muted); margin-top: 3px; }
.fund-modal .fm-x { flex: 0 0 auto; width: 28px; height: 28px; border: 1px solid var(--border); background: var(--panel, #f6f8f9); color: var(--muted); border-radius: 7px; font-size: 18px; line-height: 1; cursor: pointer; }
.fund-modal .fm-x:hover { border-color: var(--accent); color: var(--accent); }
.fund-modal .fm-body { font-size: 13px; }
.fund-modal .fm-loading { padding: 24px 0; text-align: center; color: var(--muted); }
.fund-modal .fm-src { margin-top: 12px; background: var(--panel, #f6f8f9); border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; font-size: 11.5px; color: var(--muted); line-height: 1.65; }
.fund-modal .fm-src[open] { padding-bottom: 10px; }
.fund-modal .fm-src summary { cursor: pointer; font-weight: 600; color: var(--text); outline: none; padding: 2px 0; }
.fund-modal .fm-src summary:hover { color: var(--accent); }
.fund-modal .fm-src > div { margin-top: 4px; }
.fund-modal .fm-src .fm-src-title { font-weight: 700; color: var(--text); margin-bottom: 5px; }
.fund-modal .fm-src b { color: var(--text); }
.fund-modal .fm-judge { margin: 0 0 10px; padding: 8px 11px; border-radius: 8px; font-size: 12.5px; line-height: 1.6; }
.fund-modal .fm-judge b { font-size: 15px; }
.fund-modal .fm-judge-ok { background: rgba(14,116,144,.08); border: 1px solid rgba(14,116,144,.30); color: #0b5566; }
.fund-modal .fm-judge-no { background: rgba(120,120,120,.08); border: 1px solid var(--border); color: var(--muted); }
.fund-modal .fm-table-wrap { max-height: 54vh; overflow: auto; border: 1px solid var(--border); border-radius: 8px; margin-top: 4px; }
.fund-modal .fm-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.fund-modal .fm-table th { position: sticky; top: 0; background: var(--panel, #f6f8f9); color: var(--muted); font-weight: 600; text-align: left; padding: 5px 7px; border-bottom: 1px solid var(--border); white-space: nowrap; }
.fund-modal .fm-table td { padding: 4px 7px; border-bottom: 1px solid var(--border); vertical-align: middle; white-space: nowrap; line-height: 1.35; }
.fund-modal .fm-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.fund-modal .fm-fund { white-space: nowrap; min-width: 196px; }
.fund-modal .fm-fund b { color: var(--text); display: inline; line-height: 1.4; }
.fund-modal .fm-code { display: inline; margin-left: 5px; color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
.fund-modal .fm-ty { white-space: nowrap; }
.fund-modal .fm-ty-t { margin-left: 4px; color: var(--muted); }
.fund-modal .fm-date { color: var(--muted); font-variant-numeric: tabular-nums; }
.fund-modal .fm-cal { margin-left: 5px; font-size: 10.5px; padding: 1px 7px; border-radius: 999px; border: 1px solid var(--border); white-space: nowrap; }
.fund-modal .fm-cal-exact { color: var(--accent); border-color: var(--accent); }
.fund-modal .fm-cal-approx { color: #b06a00; border-color: #e0a85a; background: rgba(224,168,90,.12); }
.fund-modal .fm-src-cell { color: var(--muted); font-size: 11px; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fund-modal .fm-mk { display: inline-block; margin-left: 0; font-size: 10.5px; padding: 1px 6px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); white-space: nowrap; }
.fund-modal .fm-mk-in { color: var(--accent); border-color: var(--accent); background: rgba(14,116,144,.08); }
.fund-modal .fm-note { padding: 12px 2px; color: var(--muted); font-size: 12.5px; line-height: 1.7; }
.fund-modal .fm-note-warn { color: #b4321b; }
.fund-modal .fm-foot { margin-top: 10px; font-size: 11px; color: var(--muted); line-height: 1.6; border-top: 1px dashed var(--border); padding-top: 8px; }
.fund-modal .fm-sort { display: inline-block; margin-right: 7px; cursor: pointer; border: 1px solid var(--border); border-radius: 6px; padding: 1px 9px; font-size: 11px; color: var(--muted); user-select: none; }
.fund-modal .fm-sort:hover { border-color: var(--accent); color: var(--accent); }
.fund-modal .fm-sort.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent, #fff); font-weight: 600; }
/* 策略数（共识度）三级：强 / 中 / 弱 —— 非价格方向，用品牌深青梯度，避免与涨跌红绿混淆 */
.fund-modal .fm-ns { font-weight: 700; border-radius: 6px; min-width: 30px; }
.fund-modal .fm-ns.ns-hi { color: #fff; background: var(--accent); }
.fund-modal .fm-ns.ns-mid { color: var(--accent); background: rgba(14,116,144,.14); }
.fund-modal .fm-ns.ns-lo { color: var(--muted); font-weight: 500; }

/* ---- 2026-09-25 个股行情 K 线 ---- */
.bull { color: var(--bull); }
.bear { color: var(--bear); }
#klineWrap { margin: 4px 0 10px; }
.kline-snap { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 16px; margin-bottom: 10px; }
.kline-snap .ks-price { font-size: 30px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1; }
.kline-snap .ks-price.bull { color: var(--bull); }
.kline-snap .ks-price.bear { color: var(--bear); }
.kline-snap .ks-pct { font-size: 16px; font-weight: 700; margin-left: 6px; }
.kline-snap .ks-grid { display: flex; flex-wrap: wrap; gap: 8px 18px; }
.kline-snap .ks-grid > div { display: flex; flex-direction: column; font-size: 12px; color: var(--muted); }
.kline-snap .ks-grid b { font-size: 14px; color: var(--text); font-variant-numeric: tabular-nums; }
.kline-canvas-wrap { position: relative; width: 100%; background: var(--panel); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
#klineCanvas { display: block; width: 100%; }
.kline-tip { position: absolute; pointer-events: none; z-index: 5; background: var(--topbar); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px; font-size: 11.5px; line-height: 1.5; font-variant-numeric: tabular-nums; box-shadow: 0 4px 14px #0003; white-space: nowrap; }
.kline-bar { display: flex; align-items: center; justify-content: space-between; margin: 10px 0 6px; gap: 10px; }
.kline-periods { display: flex; gap: 6px; }
.kbtn { border: 1px solid var(--border); background: var(--panel); color: var(--text); border-radius: 8px; padding: 5px 12px; font-size: 13px; cursor: pointer; transition: .15s; }
.kbtn:hover { border-color: var(--accent); color: var(--accent); }
.kbtn.active { background: var(--accent); border-color: var(--accent); color: var(--on-accent, #fff); font-weight: 600; }
.kline-recent { margin-top: 6px; }
.kline-recent .kr-title { font-size: 12px; color: var(--muted); margin-bottom: 6px; letter-spacing: .4px; }
.kline-chip { cursor: pointer; }
.kline-chip:hover { border-color: var(--accent); color: var(--accent); }

/* ---------- 个股「重要信息」快照（2026-09-25 新增） ----------
   涨跌配色沿用全站 A 股口径：涨=红(--bull)、跌=绿(--bear)。 */
.stk-info { display: block; margin: 4px 0 6px; }
.stk-info .si-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
.stk-info .si-price { font-size: 30px; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: var(--text); }
.stk-info .si-price.bull { color: var(--bull); }
.stk-info .si-price.bear { color: var(--bear); }
.stk-info .si-tags { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; font-size: var(--fs-lg); font-weight: 700; font-variant-numeric: tabular-nums; }
.stk-info .si-tags .bull { color: var(--bull); }
.stk-info .si-tags .bear { color: var(--bear); }
.stk-info .si-when { font-size: var(--fs-xs); font-weight: 400; color: var(--muted); }
.stk-info .si-refresh { margin-left: auto; }
.stk-info .si-sec { display: flex; align-items: center; gap: 8px; margin: 12px 0 7px; font-size: var(--fs-xs); font-weight: 700; letter-spacing: .5px; color: var(--accent); }
.stk-info .si-sec::after { content: ""; flex: 1; height: 1px; background: var(--border); }
.stk-info .si-report { color: var(--muted); font-weight: 400; letter-spacing: 0; }
.stk-info .si-grid { display: flex; flex-wrap: wrap; gap: 8px 18px; }
.stk-info .si-item { display: flex; flex-direction: column; min-width: 86px; font-size: var(--fs-xs); color: var(--muted); }
.stk-info .si-item b { font-size: var(--fs-base); color: var(--text); font-variant-numeric: tabular-nums; }
.stk-info .si-item b.bull { color: var(--bull); }
.stk-info .si-item b.bear { color: var(--bear); }
.stk-info .si-foot { margin-top: 10px; font-size: var(--fs-2xs); color: var(--muted); }
.ks-src { margin-top: 6px; font-size: var(--fs-2xs); color: var(--muted); }
/* 周期标注（周K/月K 的涨跌与「上X收」）；上市日期兜底值的口径说明 */
.ks-per { margin-left: 6px; font-size: var(--fs-2xs); font-weight: 400; opacity: .85; }
.si-est { font-style: normal; font-size: var(--fs-2xs); color: var(--muted); opacity: .85; }

/* ---------- 2026-09-25 晚：K 线「可拖动 / 可缩放」+ 价值标准三盏灯 ---------- */
.kline-canvas-wrap { cursor: crosshair; user-select: none; touch-action: none; }
.kline-canvas-wrap canvas { display: block; }
.kline-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.kline-range { font-size: var(--fs-2xs); color: var(--muted); font-variant-numeric: tabular-nums; }
.kline-range .kline-edge { color: var(--accent); }
.stk-info .si-src-note { margin-top: 6px; font-size: var(--fs-2xs); color: var(--muted); line-height: 1.55; }

/* 价值标准三盏灯：符合=深青（主题强调色），不符合=中性灰，缺数据=淡显。
   刻意不使用红/绿，避免与「涨跌」配色语义混淆。 */
.vl-row { display: flex; flex-wrap: wrap; gap: 8px; }
.vl-item {
  display: flex; align-items: center; gap: 7px; padding: 7px 11px;
  border: 1px solid var(--border); border-radius: 8px;
  background: var(--panel); font-size: var(--fs-xs); color: var(--muted);
}
.vl-item .vl-dot { flex: 0 0 auto; width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
.vl-item b { color: var(--text); font-variant-numeric: tabular-nums; }
.vl-item .vl-mark {
  font-size: var(--fs-2xs); padding: 1px 6px; border-radius: 999px;
  border: 1px solid var(--border); color: var(--muted);
}
.vl-item.vl-ok { border-color: var(--accent); }
.vl-item.vl-ok .vl-dot { background: var(--accent); }
.vl-item.vl-ok .vl-mark { color: var(--accent); border-color: var(--accent); }
.vl-item.vl-no { opacity: .78; }
.vl-item.vl-na { opacity: .55; }



/* ================= 主线研判（今日看板）2026-09-25 ================= */
/* 三档评级配色：hot=重点方向 / warm=跟进关注 / cool=仅观察
   刻意避开红涨绿跌，改用强调青 + 琥珀 + 灰，避免与行情色混淆 */
.ml-focus {
  margin: 0 0 14px;
  padding: 12px 14px;
  border-radius: 10px;
  background: linear-gradient(180deg, rgba(14,116,144,.10), rgba(14,116,144,.03));
  border: 1px solid rgba(14,116,144,.32);
}
.ml-focus-t {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--accent, #0E7490);
  margin-bottom: 9px;
  letter-spacing: .3px;
}
.ml-focus-list { display: flex; flex-wrap: wrap; gap: 8px; }
.ml-focus-item {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 12px 7px 8px;
  border-radius: 8px;
  background: var(--panel, #fff);
  border: 1px solid var(--border, #E3E7EB);
  box-shadow: 0 1px 2px rgba(15, 39, 48, .05);
}
.ml-focus-item.lv-hot {
  border-color: var(--accent, #0E7490);
  background: rgba(14,116,144,.07);
  box-shadow: 0 2px 6px rgba(14,116,144,.16);
}
.ml-focus-item.lv-warm { border-color: #D9A441; background: rgba(217,164,65,.08); }
.ml-focus-item.lv-cool { opacity: .82; }
.ml-focus-rank {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--accent, #0E7490); color: #fff;
  font-size: var(--fs-2xs); font-weight: 700;
}
.ml-focus-item.lv-warm .ml-focus-rank { background: #D9A441; }
.ml-focus-item.lv-cool .ml-focus-rank { background: #98A2B3; }
.ml-focus-name { font-size: var(--fs-md); font-weight: 700; }
.ml-focus-meta { font-size: var(--fs-xs); color: var(--muted, #6B7280); }
.ml-focus-note {
  margin-top: 9px; font-size: var(--fs-2xs); color: var(--muted, #6B7280); line-height: 1.6;
}

/* ---- 主线卡 ---- */
.ml-card {
  border: 1px solid var(--border, #E3E7EB);
  border-left-width: 4px;
  border-radius: 9px;
  padding: 11px 13px 12px;
  margin-bottom: 11px;
  background: var(--panel, #fff);
}
.ml-card.lv-hot  { border-left-color: var(--accent, #0E7490); background: rgba(14,116,144,.035); }
.ml-card.lv-warm { border-left-color: #D9A441; }
.ml-card.lv-cool { border-left-color: #C4CBD4; }

.ml-head { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; margin-bottom: 8px; }
.ml-rating {
  display: inline-block; padding: 2px 9px; border-radius: 4px;
  font-size: var(--fs-2xs); font-weight: 700; letter-spacing: .3px;
