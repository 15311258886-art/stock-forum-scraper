  .lab-cols { grid-template-columns: 1fr; }
  .lab-handle { display: none; }
  .lab-col { max-height: none; }
}

/* ================= 方向研判报告（板块动向表格下方，2026-09-26） =================
   三段式：为什么涨 / 牵涉哪些板块 / 接下来看什么。颜色全部走主题变量，
   色值只复用全局令牌（--accent/--bull/--bear/--border/--panel/--muted），不新造色。 */
