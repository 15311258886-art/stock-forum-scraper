/* ================= 刷新状态（Request G；2026-09-23 内联进顶栏） ================= */
/* 原 `.refresh-bar`（独立一行，占首屏 43px）已移除——状态点/文案/倒计时改由 `.topbar .rb-*`
   承载（见文件顶部 .topbar 规则）。此处仅保留状态圆点，供顶栏与其它场景共用。 */
/* 状态圆点：已更新=主色（青，避免误读为涨红/跌绿）/ 超时=琥珀 / 失败=红 / 未刷新=灰 */
.rs-dot { width:9px; height:9px; border-radius:50%; background:var(--muted); display:inline-block; flex:0 0 auto; }
.rs-dot.rs-ok { background:var(--accent); box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
.rs-dot.rs-stale { background:var(--warn, #f59e0b); box-shadow:0 0 0 3px color-mix(in srgb, var(--warn, #f59e0b) 24%, transparent); }
.rs-dot.rs-err { background:var(--err, #dc2626); box-shadow:0 0 0 3px color-mix(in srgb, var(--err, #dc2626) 22%, transparent); }
.rs-dot.rs-never { background:var(--muted); opacity:.55; }

/* 「最后更新」列 */
td.td-fresh { white-space:nowrap; font-variant-numeric:tabular-nums; font-size:12px; }
td.td-fresh .fresh-age { display:block; font-size:10.5px; color:var(--muted); margin-top:1px; }
td.td-fresh.fr-ok { color:var(--text); }
td.td-fresh.fr-stale { color:var(--warn, #b45309); background:var(--warn-bg, #fef3c7); font-weight:700; }
td.td-fresh.fr-stale .fresh-age { color:var(--warn, #b45309); opacity:.85; }
td.td-fresh.fr-untracked, td.td-fresh.fr-unknown, td.td-fresh.fr-loading { color:var(--muted); }
/* 超时整行告警：淡琥珀底 + 左侧竖条（不改文字颜色，避免与行情红/绿混淆） */
tr:has(> td.td-fresh.fr-stale) > td { background:var(--warn-bg, #fef3c7); }
tr:has(> td.td-fresh.fr-stale) > td:first-child { box-shadow: inset 3px 0 0 var(--warn, #f59e0b); }

/* 卡片角标（股票卡片等非表格场景） */
.chip-fresh.fr-ok { color:var(--accent); }
.chip-fresh.fr-stale { background:var(--warn-bg, #fef3c7); color:var(--warn, #b45309); font-weight:700; }
.chip-fresh.fr-untracked, .chip-fresh.fr-unknown, .chip-fresh.fr-loading { color:var(--muted); opacity:.85; }
/* 独立于 fr-* 时效语义的两种小状态：未纳入刷新 / 内容有新版本 */
.chip-fresh.chip-untracked { color:var(--muted); opacity:.85; }
.chip-fresh.chip-new { color:var(--accent); border-color:var(--accent); }

/* ================= 数据来源横幅（2026-09-24） =================
   实盘操作面板顶部横幅：当前显示的是「示例数据」还是「真实抓取」必须一眼可辨。
   否则用户反复刷新看到同一组时间戳会误以为程序卡死。
   配色沿用主题变量，避免破坏四套主题硬面板设计。 */
.banner { padding: 12px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13px; line-height: 1.65; }
.banner b { font-weight: 600; }
.banner code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 12px;
  background: rgba(0,0,0,0.06); padding: 1px 5px; border-radius: 4px; }
.banner-warn { background: #FEF3C7; color: #78350F; border: 1px solid #FBBF24; }
.banner-warn b { color: #92400E; }
.banner-warn code { background: rgba(146,64,14,0.12); color: #78350F; }
.banner-info { background: #DBEAFE; color: #1E3A8A; border: 1px solid #93C5FD; }
/* 示例数据 chip（用在表格行内、紧贴选手名字） */
.chip-demo { background: #FEF3C7 !important; color: #92400E !important; border-color: #FBBF24 !important;
  font-weight: 600; }
/* 真实数据 chip —— 与上面的「示例」成对出现。
   2026-09-25：原先「真实」和「示例」共用 .chip-demo，结果 200 个「真实」角标被画成琥珀底 + 虚线框
   （琥珀/虚线是「示例」专属视觉语言），扫一眼容易把真实数据误判成示例（UI 回归 S1）。
   此处给「真实」一个中性正向的弱绿色**实线**观感，与「示例」的琥珀**虚线**形成可辨差异。
   色值硬编码（与 .chip-demo 同理）以保证四套主题下观感一致；前景/底色对比度 ≈ 6.5:1，高于「示例」chip 的 6.4:1。 */
.chip-real { display:inline-block; margin-left:4px; padding:1px 6px; border:1px solid #86EFAC;
  border-radius:6px; font-size:10px; font-weight:600; background:#DCFCE7 !important;
  color:#166534 !important; vertical-align:middle; }
/* 表格行：示例行整行灰底（与正常行视觉差异明显，但不刺眼） */
#p-players tbody tr[data-demo] { background: #FAFAF9; }
#p-players tbody tr[data-demo]:hover { background: #F5F5F4; }
