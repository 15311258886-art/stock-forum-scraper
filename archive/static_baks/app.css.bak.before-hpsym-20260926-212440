#p-players tbody tr[data-demo] td.td-fresh { opacity: .55; }
/* trades 行同样用 data-demo 区分（截图里"东方财富/同花顺"chip 是 demo_data 给选手预设的渠道，
   并不是这些平台有抓取器）：示例行灰底 + 「示例」琥珀 chip，避免用户误以为多平台在抓 */
#p-operating tbody tr[data-demo] { background: #FAFAF9; }
#p-operating tbody tr[data-demo]:hover { background: #F5F5F4; }
#p-operating tbody tr[data-demo] td.td-fresh { opacity: .55; }


