.ol-sym:hover { border-color: var(--accent, #0E7490); color: var(--accent, #0E7490); }

.ol-src { margin-top: var(--sp-4); padding: 8px 12px; border-radius: var(--r-md); font-size: var(--fs-xs);
  color: var(--muted); line-height: 1.75; background: var(--panel, #f6f8f9); border: 1px solid var(--border); }
.ol-src summary { cursor: pointer; font-weight: 600; color: var(--text); outline: none; }
