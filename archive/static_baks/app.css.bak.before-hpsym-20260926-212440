.ov2-bar-v { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
.ov2-bar-k { text-align: right; color: var(--muted); }

/* 他们做了什么（事件动向） */
.ov2-moves { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 10px; }
.ov2-move { padding: 9px 11px; border: 1px solid var(--border); border-left-width: 3px; border-radius: var(--r-md); }
.ov2-move.dir-bull { border-left-color: var(--bull); }
.ov2-move.dir-bear { border-left-color: var(--bear); }
.ov2-move.dir-mix { border-left-color: var(--muted); }
.ov2-move-hd { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: var(--fs-xs); }
.ov2-move-hd b { font-size: var(--fs-sm, 13px); }
.ov2-move-regs { margin-left: auto; display: inline-flex; gap: 4px; }
.ov2-move-meta { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 6px; }
.ov2-move-row { margin-top: 5px; font-size: var(--fs-xs); line-height: 1.7; }
.ov2-move-row .ov-driver { margin-right: 4px; }

/* 对内陆的影响与建议 */
.ov2-bb { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.ov2-bb-col { padding: 9px 11px; border: 1px solid var(--border); border-radius: var(--r-md); }
.ov2-bb-col.up { background: rgba(220, 38, 38, .05); }
.ov2-bb-col.down { background: rgba(22, 163, 74, .06); }
.ov2-bb-hd { font-size: var(--fs-xs); font-weight: 700; margin-bottom: 6px; }
.ov2-bb-col.up .ov2-bb-hd { color: var(--bull); }
.ov2-bb-col.down .ov2-bb-hd { color: var(--bear); }
.ov2-bb-chips { display: flex; flex-wrap: wrap; gap: 5px; }
.ov2-imps { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; margin-top: 10px; }
.ov2-imp { padding: 9px 11px; border: 1px solid var(--border); border-radius: var(--r-md); }
.ov2-imp-hd { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: var(--fs-sm, 13px); }
.ov2-imp-dec { margin-top: 6px; padding: 6px 9px; border-radius: 4px; font-size: var(--fs-xs); line-height: 1.7;
  background: rgba(14, 116, 144, .07); border-left: 3px solid var(--accent, #0E7490); }
.ov2-imp-grp { margin-top: 7px; }
.ov2-imp-grp-hd { font-size: var(--fs-xs); font-weight: 700; margin-bottom: 3px; }
.ov2-imp-grp.up .ov2-imp-grp-hd { color: var(--bull); }
.ov2-imp-grp.down .ov2-imp-grp-hd { color: var(--bear); }
.ov2-imp-row { display: grid; grid-template-columns: 92px 1fr; gap: 8px; align-items: baseline;
  font-size: var(--fs-xs); padding: 2px 0; }
.ov2-imp-sec { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.ov2-imp-stks { display: flex; flex-wrap: wrap; gap: 4px; }
.ov2-imp-tx { margin-top: 6px; font-size: var(--fs-xs); line-height: 1.7; color: var(--muted); }

/* 折叠区（原始情绪 / 口径说明） */
.ov2-src, .ov2-basis { margin-top: var(--sp-4, 16px); padding: 8px 12px; border-radius: var(--r-md);
  font-size: var(--fs-xs); color: var(--muted); line-height: 1.75;
  background: var(--panel, #f6f8f9); border: 1px solid var(--border); }
.ov2-src > summary, .ov2-basis > summary { cursor: pointer; font-weight: 600; color: var(--text); outline: none; }
.ov2-src > summary:hover, .ov2-basis > summary:hover { color: var(--accent, #0E7490); }
.ov2-src-in { margin-top: 10px; }
.ov2-basis ul { margin: 6px 0 0; padding-left: 18px; }
.ov2-basis li { margin: 3px 0; }

/* 中文可读性收口（2026-09-26）：事件标题中文化后的「原文」核对入口、
   驱动源截断计数、动态新闻行的中文多空徽章 */
.ov-src-en { margin-left: 6px; font-size: 11px; font-weight: 500; color: var(--muted);
  border: 1px dashed var(--border); border-radius: 4px; padding: 0 5px; cursor: help;
  vertical-align: middle; }
.ov-src-en:hover { color: var(--accent, #0E7490); border-color: var(--accent, #0E7490); }
.ov-driver-more { font-size: 12px; color: var(--muted); }
.ov2-head .badge { margin-right: 6px; vertical-align: middle; }
