.branch-modal .bm-loading { padding: var(--sp-6) 0; text-align: center; color: var(--muted); }
.branch-modal .bm-warn { padding: 9px 12px; border-radius: var(--r-md); background: var(--panel, #f6f8f9); border: 1px solid var(--border); color: var(--muted); font-size: var(--fs-sm); line-height: 1.6; }

/* 结论条：一句话说清这个分支此刻是什么状态 */
.branch-modal .bm-judge { margin: 0 0 var(--sp-3); padding: 9px 12px; border-radius: var(--r-md); font-size: var(--fs-md); line-height: 1.68; }
