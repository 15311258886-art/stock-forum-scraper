.lab-note { font-size: 11px; color: var(--muted); margin-top: 6px; }

/* 口径受限 / 不可回测卡（中栏，均不显示数字） */
.lab-scope, .lab-nb { margin-top: 10px; }
.lab-scope-head, .lab-nb-head { font-size: 12px; font-weight: 700; color: var(--warn); margin-bottom: 6px; }
.lab-scope-item { font-size: 11.5px; color: var(--muted); line-height: 1.5; margin-bottom: 3px; }
.lab-dashed {
  border: 1px dashed var(--neutral-line); border-radius: 8px; padding: 8px 10px; margin-bottom: 6px;
  background: var(--neutral-bg);
}
.lab-dashed-lg { padding: 14px; }
.lab-dashed-title { font-weight: 700; font-size: 13px; margin: 6px 0 4px; color: var(--text); }
.lab-dashed-note { font-size: 12px; color: var(--muted); line-height: 1.6; }

/* 右栏 · 现实检验（近半年 / 近一年 双窗口） */
.lab-rd-head { margin-bottom: 8px; }
.lab-rd-title { font-size: 14px; font-weight: 700; }
.lab-rd-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 4px 0; }
.lab-rd-desc { font-size: 11.5px; color: var(--muted); line-height: 1.5; }
.lab-wins { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 8px 0; }
.lab-win { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--panel); }
.lab-win-head { font-weight: 700; font-size: 12.5px; display: flex; align-items: baseline; gap: 6px; }
.lab-win-bars { font-size: 10.5px; font-weight: 400; color: var(--muted); }
.lab-win-range { font-size: 10.5px; color: var(--muted); margin: 2px 0 6px; }
.lab-win-row { display: flex; justify-content: space-between; font-size: 12px; padding: 2px 0; }
