.lab-win-foot { margin-top: 6px; border-top: 1px dashed var(--border); padding-top: 5px; font-size: 11px; }

/* 提示 / 差异横幅（语义色：黄=注意、蓝=提示，禁用红绿） */
.lab-banner { border-radius: 8px; padding: 7px 10px; font-size: 12px; margin: 6px 0; line-height: 1.5; }
.lab-banner-warn { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-line); }
.lab-banner-info { background: var(--c2-bg); color: var(--c2-fg); border: 1px solid var(--c2-fg); }
.lab-banner-switch { background: var(--c-orange-bg); color: var(--c-orange-fg); border: 1px solid var(--c-orange-line); }
