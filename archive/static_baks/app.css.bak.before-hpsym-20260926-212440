.ml-sector { font-size: var(--fs-lg); letter-spacing: .2px; }
.ml-why { font-size: var(--fs-xs); color: var(--muted, #6B7280); }
.ml-stats { margin-left: auto; font-size: var(--fs-xs); color: var(--muted, #6B7280); }
