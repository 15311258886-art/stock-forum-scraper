   明细列给足最小宽度，避免把「股票」「时间范围」挤到只剩一两个字。 */
#p-cohold th { white-space: nowrap; }
#p-cohold td:nth-child(5) { min-width: 330px; }
#p-cohold td:nth-child(1) { min-width: 190px; }

/* ---- 2026-09-24 手动粘贴 cookie 的模态框 ---- */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 9999;
}
.modal-card {
  background: #fff; color: var(--ink);
  width: min(560px, 92vw);
  max-height: 92vh; overflow: auto;
  border-radius: 10px; padding: 20px 22px;
  box-shadow: 0 18px 48px rgba(0,0,0,.18);
}
.modal-card kbd { background:#f4f4f5; border:1px solid #d4d4d8; border-radius:3px; padding:1px 6px; font-family:Menlo,Consolas,monospace; font-size:11px; }
.modal-card code { background:#f4f4f5; padding:1px 5px; border-radius:3px; font-family:Menlo,Consolas,monospace; font-size:11px; }
