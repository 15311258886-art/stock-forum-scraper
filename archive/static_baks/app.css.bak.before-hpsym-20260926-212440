/* 中栏 · 排名表 */
.lab-table { width: 100%; border-collapse: collapse; }
.lab-table th, .lab-table td { padding: 6px 8px; font-size: 12px; border-bottom: 1px solid var(--border); }
.lab-table th { background: var(--topbar); color: var(--muted); font-weight: 600; position: sticky; top: 0; z-index: 1; cursor: help; }
.lab-table th.num, .lab-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
