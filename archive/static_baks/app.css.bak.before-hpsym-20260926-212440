.ol-note { margin-top: 6px; font-size: var(--fs-xs); color: var(--muted); line-height: 1.72; }

.ol-spill, .ol-relay { border: 1px solid var(--border); border-radius: var(--r-md); padding: 9px 11px; margin-bottom: var(--sp-2); }
