.ol-card-m { font-size: var(--fs-xs); color: var(--muted); font-variant-numeric: tabular-nums; }
.ol-kv { display: flex; gap: var(--sp-3); font-size: var(--fs-sm); line-height: 1.8; }
.ol-k { flex: 0 0 60px; color: var(--muted); }
.ol-v { flex: 1; color: var(--text); }
.ol-form { display: inline-block; margin-right: 6px; }
