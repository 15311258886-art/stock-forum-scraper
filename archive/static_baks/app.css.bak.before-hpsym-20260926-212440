  color: var(--text); padding-bottom: var(--sp-2); border-bottom: 1px solid var(--border); margin-bottom: var(--sp-3); }
.ol-sec-n { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px;
  border-radius: 50%; background: var(--accent, #0E7490); color: #fff; font-size: var(--fs-xs); font-weight: 700; }

.ol-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: var(--sp-3); }
.ol-card { border: 1px solid var(--border); border-radius: var(--r-md); background: var(--panel, #f6f8f9); padding: 10px 12px; }
