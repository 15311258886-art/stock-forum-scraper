.branch-modal .bm-cool { background: rgba(120,120,120,.07); border: 1px solid var(--border); color: var(--muted); }

.branch-modal .bm-sec { font-weight: 700; color: var(--text); font-size: var(--fs-md); margin: var(--sp-4) 0 var(--sp-2); display: flex; align-items: baseline; gap: var(--sp-2); flex-wrap: wrap; }
.branch-modal .bm-sec-n { font-weight: 400; font-size: var(--fs-xs); color: var(--muted); }

/* 表格：表头吸顶，长名单可滚，不撑破弹窗 */
.branch-modal .bm-tw { max-height: 42vh; overflow: auto; border: 1px solid var(--border); border-radius: var(--r-md); }
.branch-modal .bm-table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
.branch-modal .bm-table th { position: sticky; top: 0; z-index: 1; background: var(--panel, #f6f8f9); color: var(--muted); font-weight: 600; text-align: left; padding: 5px 8px; border-bottom: 1px solid var(--border); white-space: nowrap; }
