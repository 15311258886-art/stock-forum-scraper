.lab-caliber-tag {
  display: inline-block; margin-left: 8px; padding: 0 6px; border-radius: 6px;
  background: var(--panel); color: var(--c2-fg); border: 1px solid var(--c2-fg); font-size: 11px;
}

/* 工具栏：搜索 / 流派多选 / 开关 / 排序 */
.lab-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 10px; }
.lab-search {
  flex: 1 1 240px; min-width: 200px; padding: 6px 10px; font-size: 13px;
  border: 1px solid var(--border); border-radius: 8px; background: var(--panel); color: var(--text);
}
.lab-chips { display: flex; flex-wrap: wrap; gap: 6px; }
.lab-chip {
  cursor: pointer; user-select: none; padding: 3px 10px; border-radius: 12px; font-size: 12px;
  background: var(--tag); color: var(--text); border: 1px solid var(--border);
}
.lab-chip:hover { border-color: var(--accent); }
.lab-chip.active { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
.lab-chip-notbt.active { background: var(--warn); border-color: var(--warn); color: var(--on-accent); }
.lab-toggles { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.lab-switch { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--muted); cursor: pointer; }
.lab-sort { font-size: 12px; color: var(--muted); }
.lab-sort select {
  margin-left: 4px; padding: 4px 6px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--panel); color: var(--text); font-size: 12px;
}

/* 三栏（列宽用 CSS 变量，由拖拽手柄实时改写） */
.lab-cols {
  display: grid;
  grid-template-columns: var(--lab-wl, 300px) 8px minmax(0, 1fr) 8px var(--lab-wr, 360px);
  align-items: start;
}
.lab-col {
  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
  padding: 10px; min-width: 0; max-height: calc(100vh - 300px); overflow: auto;
}
