/* 查看器基础样式（结构/布局），颜色全部走 CSS 变量，由主题文件覆盖 */
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", system-ui, sans-serif;
  background: var(--bg); color: var(--text);
  font-size: 14px; line-height: 1.6; transition: background .25s, color .25s;
}
a { color: var(--accent); text-decoration: none; }

/* ---- P2 尺度令牌层（2026-09-23）：字号 / 圆角 / 间距与主题无关，集中在此 ---- */
:root {
  /* 字号阶梯（原 17 种取值 → 7 档；两个 clamp() 容器查询值有意保留，属 P1 成果） */
  --fs-2xs: 10px; --fs-xs: 11px; --fs-sm: 12px; --fs-md: 13px;
  --fs-base: 14px; --fs-lg: 16px; --fs-xl: 22px;
  /* 圆角（原 14 种 → 3 档；50% 圆形与 999px 胶囊按语义保留） */
  --r-sm: 6px; --r-md: 8px; --r-lg: 12px;
  /* 间距（统一到 4px 栅格；1~3px 的视觉微调保留，不参与栅格化） */
  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px;
  --sp-5: 20px; --sp-6: 24px; --sp-7: 32px; --sp-8: 40px;
}

/* 全局操作栏（2026-09-23 由「顶栏 + 独立刷新状态条」两行合并为一行）：
   原两行共 64+43=107px，现单行约 52px，首屏多还约 55px 给正文。
   padding 与字号都收紧，按钮分两级（primary 只有一个，其余降为 sm 次要按钮）以避免视觉噪声。 */
.topbar {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  padding: 8px 20px; background: var(--topbar); border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 45;   /* 高于遮罩(40)、低于详情面板(70)：面板打开时顶栏按钮仍可点击 */
}
.topbar h1 { font-size: 15px; font-weight: 700; letter-spacing: .3px; white-space: nowrap; }
.topbar .spacer { flex: 1; }
.topbar .tb-sep { width: 1px; height: 18px; background: var(--border); flex: 0 0 auto; }
.topbar .rb-item { display: inline-flex; align-items: center; gap: 6px; font-size: 12px;
  color: var(--muted); white-space: nowrap; }
.topbar .rb-cd { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums;
  white-space: nowrap; }
.topbar .btn { padding: 5px 11px; font-size: 12.5px; }
.topbar .btn.sm { padding: 4px 9px; font-size: 12px; }
.topbar .switch { font-size: 12px; }
.topbar .rb-sched { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums;
  white-space: nowrap; padding: 2px 8px; border: 1px solid var(--border); border-radius: 999px;
  background: var(--panel); }
.topbar .rb-sched.on { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.topbar .rb-sched.idle { color: var(--muted); }
.topbar .rb-sched.off { color: var(--warn, #f59e0b); border-color: color-mix(in srgb, var(--warn, #f59e0b) 40%, var(--border)); opacity: .85; }
.topbar .rb-poll { font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums;
  white-space: nowrap; padding: 2px 8px; border: 1px solid var(--border); border-radius: 999px;
  background: var(--panel); }
.topbar .rb-poll.on { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
.topbar .rb-poll.idle { color: var(--muted); }
.topbar .rb-poll.off { color: var(--warn, #f59e0b); border-color: color-mix(in srgb, var(--warn, #f59e0b) 40%, var(--border)); opacity: .85; }
.topbar .rb-poll { cursor: pointer; transition: color .15s, border-color .15s; }
.topbar .rb-poll:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
/* 窄屏逐级卸载顶栏次要信息：先丢倒计时，再丢分隔线，最后标题收窄，保证按钮始终可点 */
@media (max-width: 1360px) { .topbar h1 { font-size: 14px; } }
@media (max-width: 1180px) { .topbar .rb-cd { display: none; } .topbar .tb-sep { display: none; } }
.btn {
  border: 1px solid var(--border); background: var(--panel); color: var(--text);
  padding: 7px 13px; border-radius: 8px; cursor: pointer; font-size: 13px; transition: .15s;
}
.btn:hover { border-color: var(--accent); color: var(--accent); }
.btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
.btn.primary:hover { filter: brightness(1.08); color:#fff; }
.theme-pick { display: flex; gap: 6px; }
.theme-pick .chip {
  width: 26px; height: 26px; border-radius: 50%; cursor: pointer; border: 2px solid transparent;
  box-shadow: inset 0 0 0 2px #0001;
}
.theme-pick .chip.active { border-color: var(--text); }
.switch { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }

/* 应用外壳（2026-09-23 布局改造）：左栏贴视口最左缘 + 内容区满宽，取代原居中 .wrap。
   原 `.wrap { max-width:1280px; margin:0 auto }` 是「左右大片空白」的根因——实测 1920 视口下
   两侧各浪费 320px（合计 33%），2560 下各浪费 640px（合计 50%）；且卡片宽度被锁死在 164px，
   与窗口多宽无关，所以内容越看越挤。 */
.shell { display: grid; grid-template-columns: 236px minmax(0, 1fr); align-items: start;
  min-height: calc(100vh - 58px); }
.content { min-width: 0; padding: 18px 24px 60px; }
/* 其他面板里的通用卡片网格（结构是 .t/.v/.s），保持自动换行不变 */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 14px; margin-bottom: 18px; }
/* 通用卡片底样式：共 9 处使用（汇总-登录态 / 数据源 / 原始存档 / 抓取记录 等），
   它们的内层结构是 .t/.v/.s，与顶部统计条的 .n/.l/.more 不同，**不能一并收窄到 #cards**。 */
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }

/* ===== 顶部统计条 #cards（2026-09-23 二次改造：单排不换行 + 随容器等比例缩放）=====
   改造前实测的两个缺陷（2560→1100 六档量取）：
   ① 换行：`repeat(auto-fit, minmax(200px,1fr))` 在 1920 只排出 7 列 → 9 张卡挤成 2 行，
      1280 下 4 列 → 3 行。列数由「可用宽度 ÷ 200px」决定，与卡片数无关，必然折行。
   ② 不缩放：`.n/.l/.more` 字号写死 26/12/11px；卡片宽度在 240→263px 之间乱跳（auto-fit
      的剩余空间分配不均），跟容器尺寸没有任何比例关系。
   修法（两条一一对应）：
   - 列数 = 卡片数：JS 把卡片数写进 --cn，`repeat(var(--cn, 9), minmax(0,1fr))` → 恒定单排；
   - #cards 声明为查询容器（container-type:inline-size），字号/内边距/圆角/间距全部用 cqw
     表达 → 与容器宽度成线性比例（这才是「等比例缩放」）；clamp 只兜住上下限，避免极小
     或超大屏时失真。
   注意：只作用于 #cards。`.cards` 另被 3 处面板复用（结构 .t/.v/.s），不能被牵连。 */
#cards { display: grid; grid-template-columns: repeat(var(--cn, 9), minmax(0, 1fr));
  gap: clamp(6px, .7vw, 14px); margin-bottom: 18px; container-type: inline-size; }
#cards .card { background: var(--panel); border: 1px solid var(--border);
  border-radius: clamp(8px, .55cqw, 12px); padding: clamp(8px, .75cqw, 17px);
  min-width: 0; display: flex; flex-direction: column; }
#cards .card .n { font-size: clamp(15px, 1.3cqw, 32px); font-weight: 800; color: var(--accent);
  line-height: 1.14; }
#cards .card .l { color: var(--muted); font-size: clamp(10px, .62cqw, 12.5px);
  margin-top: clamp(1px, .1cqw, 3px); line-height: 1.3; overflow-wrap: break-word; }
/* 统计卡片可点击：给出明确的「可点」视觉与「查看明细」入口（2026-09-23）
   .more 用 margin-top:auto 沉到卡底 → 单排后卡高一致，视觉更整齐 */
#cards .card.clickable { cursor: pointer; transition: border-color .15s, transform .15s, box-shadow .15s; }
#cards .card.clickable:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 6px 18px #0002; }
#cards .card.clickable:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
#cards .card .more { margin-top: auto; padding-top: clamp(5px, .5cqw, 9px);
  font-size: clamp(9.5px, .5cqw, 11.5px); color: var(--accent); opacity: .75; white-space: nowrap; }
#cards .card.clickable:hover .more, #cards .card.clickable:focus-visible .more { opacity: 1; }
/* 窄屏（≤1024px）单排会把卡片压到 80px 出头、汉字已难辨认 → 退回自动换行；
   字号仍走上面的 cqw 缩放，不受此处影响 */
@media (max-width: 1024px) {
  #cards { grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); }
}
/* 统计明细表：允许自然宽度（宽表横向滚动由 .drawer-body 统一处理）；行可下钻 */
.tbl-detail { min-width: 0; }
.tbl-detail tr.rowlink { cursor: pointer; }
.tbl-detail .mono { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; letter-spacing: .4px; }
.tbl-detail .s { color: var(--muted); }

/* ================= 主导航（2026-09-23 三次改造）：左栏只放「大类」，子类回到内容区横向平铺
   演变：① 单排 10 个 Tab 挤一行 → ② 两级都塞进左栏（手风琴）→ ③ 现在这个版本。
   为什么要回到横向：手风琴把子项挤在 236px 的左栏里，窄条难以点击、且每切大类整栏都在跳。
   现在左栏只承担「选哪一大类」——条目少、位置稳定；子类在内容区顶部横向平铺，逐个点选顺手。
   两级结构仍由 app.js 的 NAV 配置单一来源生成；.panel 容器与显隐规则完全不变，面板渲染零改动。 */
.sidenav { position: sticky; top: 58px; align-self: start; display: flex; flex-direction: column;
  min-height: calc(100vh - 58px); max-height: calc(100vh - 58px); overflow-y: auto;
  background: var(--panel); border-right: 1px solid var(--border); padding: 14px 12px 18px; }
.rail-head { font-size: 11px; color: var(--muted); letter-spacing: .8px; padding: 2px 9px 10px; }
.nav-item { display: flex; align-items: center; gap: 9px; padding: 10px 11px; border-radius: 10px;
  color: var(--text); text-decoration: none; font-size: 13.5px; border: 1px solid transparent; }
.nav-item:hover { background: var(--tag); }
/* 选中态文字色走 --on-accent：accent 在 4 套主题里有亮有暗，写死 #fff 在
   dark-dashboard（亮青 #22D3EE）只有 1.81:1 对比度，几乎看不清 */
.nav-item.active { background: var(--accent); color: var(--on-accent, #fff); border-color: var(--accent); font-weight: 600; }
.nav-item.active .ni-n { opacity: .85; }
.ni-ico { width: 15px; text-align: center; opacity: .85; flex: 0 0 auto; }
.ni-txt { flex: 1 1 auto; }
.ni-n { font-size: 11px; opacity: .55; flex: 0 0 auto; }

/* ---- 二级导航：内容区顶部的横向平铺子板块 ---- */
.subnav { display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
.sub-tab { padding: 7px 14px; border-radius: 8px; border: 1px solid var(--border);
  background: var(--panel); color: var(--text); text-decoration: none;
  font-size: 13px; line-height: 1.35; white-space: nowrap; }
.sub-tab:hover { border-color: var(--accent); color: var(--accent); }
.sub-tab.active { background: var(--accent); border-color: var(--accent);
  color: var(--on-accent, #fff); font-weight: 600; }
.subnav-spacer { flex: 1 1 auto; }

/* 窄屏（≤1080）：左栏也折成横排（大类 + 子类共处一栏横向滚动），仍保留两级语义 */
@media (max-width: 1080px) {
  .shell { grid-template-columns: minmax(0, 1fr); min-height: 0; }
  .sidenav { position: static; min-height: 0; max-height: none; overflow: visible;
    border-right: none; border-bottom: 1px solid var(--border);
    flex-direction: row; flex-wrap: wrap; align-items: center; gap: 6px; padding: 9px 14px; }
  .rail-head { display: none; }
  .nav-item { padding: 7px 11px; white-space: nowrap; }
  .subnav { margin-bottom: 12px; padding-bottom: 8px; }
  .sub-tab { padding: 6px 11px; font-size: 12px; }
  .content { padding: 14px 16px 48px; }
}

.panel { display: none; }
.panel.active { display: block; }

.toolbar { display:flex; align-items:center; gap:10px; margin-bottom:12px; color: var(--muted); font-size:12px; }

/* ================= 面板内「筛选栏」竖向排列（2026-09-23） =================
   改前：实盘选手面板把 6 个层级 + 5 个渠道按钮各挤成一行（实测 1048×27、flex-wrap:nowrap），
   单个按钮仅约 60px 宽、高 27px，极易点错。改后：筛选独立成一列，每项一行、高 34px+，
   与表格左右并排，顺手就把加宽后的横向空间用起来了。 */
.panel-split { display: grid; grid-template-columns: minmax(170px, 200px) minmax(0, 1fr);
  gap: 18px; align-items: start; }
.filter-col { position: sticky; top: 70px; display: flex; flex-direction: column; gap: 3px;
  background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 10px; }
.fc-h { font-size: 11px; color: var(--muted); letter-spacing: .6px; padding: 5px 9px 6px; }
.fc-sep { height: 1px; background: var(--border); margin: 7px 3px 3px; }
.fbtn { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; cursor: pointer;
  padding: 9px 10px; border-radius: 9px; border: 1px solid transparent; background: transparent;
  color: var(--text); font-family: inherit; font-size: 13px; transition: .15s; }
.fbtn:hover { background: var(--tag); }
.fbtn.active { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
.fbtn .cnt { margin-left: auto; font-size: 11px; opacity: .7; font-variant-numeric: tabular-nums; }
@media (max-width: 1080px) {
  .panel-split { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .filter-col { position: static; }
}

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px,1fr)); gap: 12px; }
.box { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 14px; cursor: pointer; transition: .15s; }
.box:hover { border-color: var(--accent); transform: translateY(-2px); }
.box .t { font-weight: 700; font-size: 15px; }
.box .s { color: var(--muted); font-size: 12px; margin-top: 4px; }
.box .meta { margin-top: 8px; display:flex; gap:6px; flex-wrap: wrap; }
/* 纯展示卡片：不显示可点击指针与悬停位移，避免"假按钮"误导 */
.box.static { cursor: default; }
.box.static:hover { border-color: var(--border); transform: none; }
.chip-s { background: var(--tag); border-radius: 6px; padding: 2px 8px; font-size: 11px; color: var(--text); }
/* 仅解析到股票名、暂无代码的持仓：虚线弱化 + 问号提示，明确「待匹配代码」 */
.chip-s.chip-nm { border: 1px dashed var(--muted); background: transparent; color: var(--muted); }
/* 数据来源=选手自己主页/实盘记录（区别于个股讨论页提及）的小绿徽章 */
.src-tag { display:inline-block; margin-left:3px; padding:0 4px; font-size:9px; line-height:14px;
  border-radius:4px; background:#0E7490; color:#fff; vertical-align:middle; }
/* 持仓性质细分（按站点）：实盘=淘股吧交割单(深青) / 组合=雪球·摩尔跟随真实调仓(绿) / 晒盘=集思录手动记账(琥珀) / 提及=讨论页提到(灰) */
.src-tag.src-port { background:#15803D; }
.src-tag.src-comm { background:#B45309; }
.src-tag.src-mention { background:#6B7280; }
/* 持仓徽章内的「操作时间」（2026-09-25 补：与「共同持仓」口径一致，不再只藏在悬停提示里） */
.chip-time { display:inline-block; margin-left:3px; padding:0 4px; font-size:9px; line-height:14px; border-radius:4px;
  background:rgba(14,116,144,.12); color:#0E7490; vertical-align:middle; white-space:nowrap; }
.chip-time-none { background:transparent; color:var(--muted,#9CA3AF); border:1px dashed rgba(156,163,175,.5); }
/* 集思录社区晒盘选手角标 */
.chip-comm { display:inline-block; margin-left:4px; padding:1px 6px; border-radius:6px; font-size:10px; color:#fff; background:#B45309; vertical-align:middle; }
/* 示例来源：无可跳转出处时以灰色虚线标注，明确「不可点」而非伪装成真链接 */
.src-demo-text { color: var(--muted); }
.chip-demo { display:inline-block; margin-left:4px; padding:1px 6px; border:1px dashed var(--muted); border-radius:6px; font-size:10px; color:var(--muted); background:transparent; vertical-align:middle; }
.badge { display:inline-block; padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight:700; }
.badge.buy { background: var(--bull-bg); color: var(--bull); }
.badge.sell { background: var(--bear-bg); color: var(--bear); }
.badge.hold { background: var(--tag); color: var(--muted); }
.badge.bull { background: var(--bull-bg); color: var(--bull); }
.badge.bear { background: var(--bear-bg); color: var(--bear); }
.badge.neu { background: var(--tag); color: var(--muted); }
.badge.ch-A { background: #fef3c7; color: #b45309; }
.badge.ch-B { background: #dbeafe; color: #1d4ed8; }
.badge.ch-C { background: #dcfce7; color: #15803d; }
.badge.ch-D { background: #fae8ff; color: #a21caf; }
/* 来源渠道·平台徽章（名称来自哪个论坛） */
.badge.p-taoguba { background: #ffedd5; color: #c2410c; }
.badge.p-eastmoney { background: #dbeafe; color: #1d4ed8; }
.badge.p-xueqiu { background: #dcfce7; color: #15803d; }
.badge.p-ths { background: #f3e8ff; color: #7e22ce; }
.src-line { margin-top: 4px; display: flex; gap: 4px; flex-wrap: wrap; }
.cert-badge { display:inline-block; padding:1px 8px; border-radius:10px; font-size:12px; font-weight:700;
  background:#0a7d3c; color:#fff; vertical-align:middle; }
.chip-row { display:inline-block; margin:2px 6px 2px 0; }
.btn.sm { padding: 4px 10px; font-size: 12px; }

table { width: 100%; border-collapse: collapse; background: var(--panel); border-radius: 12px; overflow: hidden;
  border: 1px solid var(--border); }
th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); font-size: 13px; }
/* 数值列右对齐 + 等宽数字：表头也要一起右对齐，否则表头与列内容错位。
   注意必须同时覆盖 th.num——只写 td.num 的话表头会落回 th{text-align:left}，
   本次就是这样漏掉 9 个表头（探针抓到） 。 */
th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
th { background: var(--topbar); color: var(--muted); font-weight: 600; }
tr:hover td { background: var(--hover); cursor: pointer; }

.status-dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:6px; }
.dot-ok { background:#22c55e; } .dot-no { background:#f59e0b; } .dot-fail { background:#ef4444; }
.dot-pub { background:#38bdf8; } .dot-err { background:#ef4444; }

/* 登录态行 + 可点击的登录入口（2026-09-23：把「需要登录的网站」直接给成可点链接） */
.login-row { display:flex; align-items:center; flex-wrap:wrap; gap:4px 8px;
  padding:5px 0; font-size:12.5px; }
.login-row + .login-row { border-top:1px dashed var(--border); }
.login-link { color:var(--accent); font-weight:600; text-decoration:none; }
.login-link:hover { text-decoration:underline; }

.bars { display:flex; gap:10px; flex-wrap:wrap; }
.bar-card { background: var(--panel); border:1px solid var(--border); border-radius:12px; padding:14px; flex:1; min-width:160px; }
.bar-val { font-size:22px; font-weight:800; }
.bar-val.bull { color: var(--bull); } .bar-val.bear { color: var(--bear); } .bar-val.neu { color: var(--muted); }

/* 说明文字：全站 16 段、合计 2629 字，最长单段 196 字。三处收敛（2026-09-23）：
   ① 限行宽用 ch，中文舒适阅读约 30~45 字/行（实测改前 2560px 下一行长达 188 字）。
      **只加在折叠后的正文块上，不加在 .hint 容器上**——容器带底色，若一并限宽，
      一条 546px 的色块会孤零零停在 1400px 的内容区左侧，既像"没画完的卡片"，
      也违背「充分利用左右空白」的既有要求。容器保持满宽，色块与布局栅格对齐。
   ② 超长说明交给 .hint-fold 折成 2 行（见下）。
   ③ 顶部提示条用 .hint-slim 收紧内边距。 */
.hint { color: var(--muted); font-size: 12px; background: var(--tag); border-radius: 8px;
  padding: 10px 12px; margin-bottom: 14px; }
.hint-slim { padding: 6px 11px; margin-bottom: 10px; }
/* 折叠：默认 2 行，点「展开说明」看全文。由 app.js foldLongHints() 在渲染后自动施加，
   仅对超过阈值的说明生效，新增面板无需改动即自动适用。.hint 与 .kb-note 共用这套类名。 */
.hint-fold .hint-body { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; max-width: 84ch; }
.hint-fold.open .hint-body { display: block; overflow: visible; }
.hint-fold .hint-more { display: inline-block; margin-top: 5px; padding: 0; border: 0;
  background: none; font-size: 11.5px; color: var(--accent); cursor: pointer; }
.hint-fold .hint-more:hover { text-decoration: underline; }
.hint code { font-size: 11.5px; background: var(--panel); border-radius: 4px; padding: 1px 4px; }

/* 详情面板：浮动窗口（可拖拽 / 可拉伸 / 多入口关闭 / 层级：顶栏45 < 遮罩40? 见下） */
/* 层级：遮罩 40（可点背景） → 顶栏 45 → 详情面板 70 */
.drawer-mask { position: fixed; inset: 0; background: #000000; opacity: .22; display: none; z-index: 40; pointer-events: none; }
.drawer-mask.show { display: block; }

.drawer {
  position: fixed; display: none; flex-direction: column; overflow: hidden;
  background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
  box-shadow: 0 18px 50px #0005, 0 2px 8px #0002;
  z-index: 70;
}
.drawer.show { display: flex; }
.drawer.ghost { opacity: .72; }              /* 半透明：透看被遮挡的表格 */

.drawer-head {
  flex: 0 0 auto; display: flex; align-items: center; gap: 8px;
  padding: 9px 12px; background: var(--topbar); border-bottom: 1px solid var(--border);
  cursor: move; user-select: none; touch-action: none;
}
/* 2026-09-27：标题栏前面加显眼拖动手柄图标（3×2 圆点 = "可拖动" 的视觉约定）；光标变 grab 让可拖动一眼可见 */
.drawer-head::before {
  content: "⋮⋮";
  display: inline-block;
  font-size: 14px;
  line-height: 1;
  color: var(--muted);
  margin-right: 2px;
  letter-spacing: -2px;
  cursor: grab;
}
.drawer-head:hover::before { color: var(--accent); }
.drawer-head:active::before { cursor: grabbing; }
.drawer-title { flex: 1; min-width: 0; font-size: 14px; font-weight: 700;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.drawer-tools { display: flex; gap: 6px; flex-shrink: 0; }
.dbtn { border: 1px solid var(--border); background: var(--panel); color: var(--text);
  border-radius: 8px; padding: 3px 9px; font-size: 12px; line-height: 1.6; cursor: pointer; transition: .15s; }
.dbtn:hover { border-color: var(--accent); color: var(--accent); }
.dbtn.on { background: var(--accent); color: #fff; border-color: var(--accent); }
.dbtn.close:hover { border-color: #ef4444; color: #ef4444; }

.drawer-body { flex: 1 1 auto; overflow: auto; padding: 16px 18px 20px; overscroll-behavior: contain; }
.drawer-foot { flex: 0 0 auto; display: flex; align-items: center; gap: 10px;
  padding: 9px 14px; border-top: 1px solid var(--border); font-size: 12px; color: var(--muted); }
.drawer-foot #drawerTip { flex: 1; }
.drawer-resize { position: absolute; right: 0; bottom: 0; width: 24px; height: 24px; cursor: nwse-resize;
  touch-action: none; opacity: .6;
  background:
    linear-gradient(135deg, transparent 0 38%, var(--accent) 38% 44%, transparent 44% 56%, var(--accent) 56% 62%, transparent 62% 74%, var(--accent) 74% 80%, transparent 80%);
  border-bottom-right-radius: 11px;
}
.drawer-resize:hover { opacity: 1; }

.drawer h3 { margin-bottom: 12px; font-size: 16px; }
/* 面板内表格：列宽不足时横向滚动，避免挤压缩排导致价格等关键列不可读 */
.drawer-body table { min-width: 620px; }
.drawer-body table th, .drawer-body table td { padding: 8px 9px; font-size: 12.5px; white-space: nowrap; }
.drawer-body .box { cursor: default; }
.drawer-body .box:hover { transform: none; }
.kv { display:flex; gap:8px; padding: 6px 0; border-bottom: 1px dashed var(--border); font-size: 13px; }
.kv .k { width: 90px; color: var(--muted); flex-shrink:0; }
.raw { background: var(--tag); border-radius: 8px; padding: 12px; margin-top: 12px; font-size: 12px;
  white-space: pre-wrap; word-break: break-all; max-height: 360px; overflow: auto; color: var(--text); }
.empty { text-align:center; color: var(--muted); padding: 40px; }

/* ---- 选手详情页：实盘交易完整明细 ---- */
.access-badge { display:inline-block; padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight:700; }
.access-free  { background: var(--tag); color: var(--muted); }
.access-paid  { background: #fef3c7; color: #b45309; }
.access-points{ background: #dbeafe; color: #1d4ed8; }
.access-locked{ background: #fee2e2; color: #b91c1c; }
.access-banner { background: #fff7ed; border: 1px solid #fdba74; color: #9a3412; border-radius: 10px;
  padding: 12px 14px; margin-bottom: 16px; font-size: 13px; }
.access-banner b { color: #b91c1c; }
.access-banner ul { margin: 8px 0 0 18px; }
.access-banner li { margin: 3px 0; }
.pl-up { color: #dc2626; font-weight: 700; }   /* 涨：红（A股惯例） */
.pl-down { color: #16a34a; font-weight: 700; } /* 跌：绿（A股惯例） */
.pl-flat { color: var(--muted); }
/* 持仓起始日期 / 已持有天数 / 已清仓 标注 */
.hold-since { color: var(--text); }
.hold-days { display:block; font-size: 11px; color: var(--muted); margin-top: 1px; }
.row-closed td { background: var(--tag); }
.row-closed td:first-child { box-shadow: inset 3px 0 0 #b45309; }
.badge.closed-badge { background:#fef3c7; color:#b45309; border:1px solid #fcd34d; }
.badge.sell-full { background:#fee2e2; color:#b91c1c; }
.badge.sell-part { background:#fef3c7; color:#b45309; }
.badge .hold-mini { font-style: normal; font-size: 10px; opacity: .75; margin-left: 3px; }
.badge .sell-mini { color: #b91c1c; }
/* 卖出表：列少、内容窄，允许自适应收缩以完整显示（其他宽表仍保留 min-width 横向滚动） */
.drawer-body table.tbl-sell { min-width: 0; }
.drawer-body table.tbl-sell td, .drawer-body table.tbl-sell th { padding: 8px 6px; }
.drawer-body table.tbl-sell td:last-child { white-space: nowrap; }
.detail-sub { font-size: 13px; color: var(--muted); margin: 14px 0 6px; font-weight: 600; }
.op-row { display:flex; gap:10px; align-items:baseline; flex-wrap: wrap; padding: 9px 12px; border-radius: 10px;
  background: var(--panel); border:1px solid var(--border); margin-bottom: 8px; font-size: 13px; }
.op-row .t { color: var(--muted); min-width: 152px; white-space: nowrap; font-variant-numeric: tabular-nums; }
.op-row .sym { font-weight: 700; min-width: 120px; white-space: nowrap; }
.op-row .note { color: var(--muted); font-size: 12px; white-space: nowrap; }
.lock-tag { display:inline-block; background:#fee2e2; color:#b91c1c; border-radius:6px; padding:2px 8px; font-size:11px; font-weight:700; }
.free-tag { display:inline-block; background: var(--tag); color: var(--muted); border-radius:6px; padding:2px 8px; font-size:11px; }

/* ---- 股票卡片（情绪地图 / 当前讨论股票）：名称优先，代码与公司全称逐项标注 ---- */
.stk-card { display:flex; flex-direction:column; gap:8px; min-height:118px; }
.stk-top { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.stk-name { font-size:17px; font-weight:800; letter-spacing:.3px; line-height:1.25; word-break:break-word; overflow-wrap:anywhere; }
.stk-name.missing { font-size:13px; font-weight:600; color:var(--muted); }
.stk-board { font-size:11px; color:var(--muted); border:1px solid var(--border); border-radius:999px;
  padding:1px 8px; white-space:nowrap; }
.stk-sub { display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
.stk-code { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size:12.5px;
  letter-spacing:.8px; background:var(--tag); border:1px solid var(--border);
  border-radius:6px; padding:2px 8px; color:var(--text); }
.stk-corp { font-size:12px; color:var(--muted); line-height:1.4; word-break:break-word; }
.stk-corp.unknown { opacity:.72; font-style:italic; }
.stk-meta { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:auto; }
.stk-total { font-size:11px; color:var(--muted); margin-left:2px; }
.stk-hint { font-size:11px; color:var(--accent); }

/* 图例：解释卡片上每个数字/标签的含义 */
.legend { background:var(--panel); border:1px solid var(--border); border-radius:10px;
  padding:11px 14px; margin-bottom:14px; font-size:12px; color:var(--muted); }
.legend .lg-title { font-weight:700; color:var(--text); margin-bottom:6px; }
.legend .lg-row { display:flex; gap:8px; align-items:baseline; margin:3px 0; }
.legend .lg-key { flex:0 0 auto; min-width:74px; }
.legend .lg-sample { font-family: ui-monospace, Consolas, monospace; }
.legend .lg-act { margin-top:8px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
/* 精简版提示条：仅"有 N 个代码未识别 + 补全按钮"，单行不占版面 */
.legend.lg-compact { display:flex; align-items:center; gap:10px; flex-wrap:wrap; padding:8px 12px; }

/* ---- 「当前讨论股票」密度优化（王总 2026-09-26：卡片略缩小、一屏更多信息、提及次数高亮）
   仅作用于 #p-stocks，不影响复用同组件的「舆情情绪」面板。 */
#p-stocks .grid { grid-template-columns: repeat(auto-fill, minmax(186px,1fr)); gap: 10px; }
#p-stocks .stk-card { min-height: 96px; gap: 6px; padding: 11px 12px; }
#p-stocks .stk-name { font-size: 15px; }
#p-stocks .stk-sub { gap: 6px; }
#p-stocks .stk-code { font-size: 11px; padding: 1px 7px; letter-spacing: .5px; }
#p-stocks .stk-corp { font-size: 11px; flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#p-stocks .stk-meta { gap: 5px; }

/* 被提及次数：高亮主标（深青描边 + 浅底 + 数字加粗放大），一眼可辨 */
.stk-mention { display:inline-flex; align-items:baseline; gap:3px;
  background: color-mix(in srgb, var(--accent) 13%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
  color: var(--accent); border-radius: 6px; padding: 2px 9px;
  font-size: 11px; font-weight: 600; line-height: 1.5; }
.stk-mention b { font-size: 14px; font-weight: 800; }

/* 多空观点明细（谁看多/看空 + 理由） */
.views { display:flex; flex-direction:column; gap:10px; margin:4px 0 4px; }
.view-group { border:1px solid var(--border); border-radius:10px; padding:8px 12px; }
.view-group.v-bull { border-left:4px solid var(--bull); background: color-mix(in srgb, var(--bull-bg) 55%, transparent); }
.view-group.v-bear { border-left:4px solid var(--bear); background: color-mix(in srgb, var(--bear-bg) 55%, transparent); }
.view-group.v-neu  { border-left:4px solid var(--muted); background: var(--panel); }
.vg-head { font-weight:700; font-size:13px; margin-bottom:6px; }
.vg-empty { font-size:12px; color:var(--muted); }
.view-item { padding:6px 0; border-top:1px dashed var(--border); }
.view-item:first-of-type { border-top:none; }
.vi-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.vi-author { font-size:13px; color:var(--text); }
.vi-time { font-size:11px; color:var(--muted); font-variant-numeric:tabular-nums; }
.vi-site { font-size:11px; color:var(--accent); background:var(--tag); border-radius:6px; padding:1px 7px; }
.vi-reason { font-size:12.5px; line-height:1.55; color:var(--text); margin-top:3px; word-break:break-word; }

/* ================= 海外舆情（模块一 / 模块二） ================= */
/* 层级 E/F 徽章（低层级权重递减，但一律露出）；t-w 为加权共识徽章 */
.badge.ch-E { background:#e0f2fe; color:#0369a1; }
.badge.ch-F { background:#f1f5f9; color:#475569; }
.badge.t-A { background:#fef3c7; color:#b45309; }
.badge.t-B { background:#dbeafe; color:#1d4ed8; }
.badge.t-C { background:#dcfce7; color:#15803d; }
.badge.t-D { background:#fae8ff; color:#a21caf; }
.badge.t-E { background:#e0f2fe; color:#0369a1; }
.badge.t-F { background:#f1f5f9; color:#475569; }
.badge.t-w { background:var(--tag); color:var(--accent); }
.badge.sec { background:#dcfce7; color:#15803d; }
/* 区域徽章 */
.badge.rg-us { background:#fee2e2; color:#b91c1c; }
.badge.rg-hk { background:#dbeafe; color:#1d4ed8; }
.badge.rg-gl { background:#ede9fe; color:#6d28d9; }
.badge.rg-sg { background:#ccfbf1; color:#0f766e; }
.badge.rg-cn { background:#f1f5f9; color:#475569; }
/* 选手层级筛选按钮上的计数 */
.btn.sm .cnt { opacity:.7; font-size:11px; margin-left:3px; }

/* 情绪温度计 */
.ov-mood { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin-bottom:6px; }
.ov-mood-head { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px; }
.ov-mood-label { font-weight:700; }
.ov-mood-val { font-weight:800; font-size:16px; }
.ov-thermo { height:14px; background:linear-gradient(90deg,#16a34a,#fde047,#dc2626); border-radius:999px; position:relative; opacity:.28; }
.ov-thermo-fill { position:absolute; top:0; right:auto; bottom:0; left:0; border-radius:999px; opacity:1; mix-blend-mode:hard-light; }
.ov-thermo-scale { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); margin-top:4px; }

/* 趋势图 */
.ov-chart { background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:10px 12px; margin-bottom:14px; }
.ov-chart svg { display:block; }
.ov-legend { display:flex; gap:14px; flex-wrap:wrap; margin-top:6px; font-size:12px; color:var(--muted); }
.ov-legend .lg-item { display:inline-flex; align-items:center; gap:5px; }
.ov-legend .lg-item i { width:12px; height:12px; border-radius:3px; display:inline-block; }

/* 三栏布局 */
.ov-cols { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-bottom:8px; }
.ov-regions { display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:8px; }
.ov-region { border:1px solid var(--border); border-left:4px solid var(--muted); border-radius:10px; padding:8px 10px; }
.ov-region.rg-us { border-left-color:#dc2626; }
.ov-region.rg-hk { border-left-color:#2563eb; }
.ov-region.rg-gl { border-left-color:#7c3aed; }
.ov-region.rg-sg { border-left-color:#14b8a6; }
.ov-region.rg-cn { border-left-color:#64748b; }
.ov-rg-top { display:flex; justify-content:space-between; font-size:12px; }
.ov-rg-name { font-weight:700; }
.ov-rg-weight { color:var(--muted); font-size:11px; }
.ov-rg-n { font-size:16px; font-weight:800; margin-top:4px; }
.ov-rg-heat { font-size:11px; color:var(--muted); }

.ov-src { display:flex; align-items:center; gap:8px; padding:5px 0; border-bottom:1px dashed var(--border); font-size:12.5px; }
.ov-src-name { font-weight:600; min-width:120px; }
.ov-sym { padding:4px 0; font-size:12.5px; }
.ov-sym b { font-family:ui-monospace,Consolas,monospace; }

/* 新闻列表 */
.ov-news-list { display:flex; flex-direction:column; gap:8px; }
.ov-news { border:1px solid var(--border); border-radius:10px; padding:8px 12px; background:var(--panel); }
.ov-news-top { display:flex; align-items:center; gap:8px; font-size:12px; }
.ov-news-src { font-weight:600; }
.ov-news-time { color:var(--muted); margin-left:auto; font-variant-numeric:tabular-nums; }
.ov-news-title { margin:4px 0; font-size:13.5px; line-height:1.5; }
.ov-news-topic { display:flex; gap:6px; flex-wrap:wrap; }

/* 数据源接入状态 */
.ov-sources { margin-top:6px; }
.ov-src-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:10px; }
.ov-src-status { border:1px solid var(--border); border-radius:10px; padding:10px 12px; background:var(--panel); }
.ov-src-st-top { display:flex; justify-content:space-between; align-items:center; gap:8px; }
.ov-src-st-badge { font-size:11px; font-weight:700; padding:2px 8px; border-radius:6px; }
.ov-src-status.src-on { border-left:4px solid #16a34a; }
.ov-src-status.src-on .ov-src-st-badge { background:#dcfce7; color:#15803d; }
.ov-src-status.src-wait { border-left:4px solid #f59e0b; }
.ov-src-status.src-wait .ov-src-st-badge { background:#fef3c7; color:#b45309; }
.ov-src-status.src-err { border-left:4px solid #ef4444; }
.ov-src-status.src-err .ov-src-st-badge { background:#fee2e2; color:#b91c1c; }
.ov-src-status.src-demo { border-left:4px solid #2563eb; }
.ov-src-status.src-demo .ov-src-st-badge { background:#dbeafe; color:#1d4ed8; }
.ov-src-status.src-off { border-left:4px solid #9ca3af; }
.ov-src-status.src-off .ov-src-st-badge { background:#f3f4f6; color:#6b7280; }
/* 「已连通但无条目」（如 PeerTube）：通道可达、按主题过滤后确无条目，属客观现状而非错误 —— 中性黄 */
.ov-src-status.src-neutral { border-left:4px solid #d1a24a; }
.ov-src-status.src-neutral .ov-src-st-badge { background:#fdf6e3; color:#8a6d1f; }
.ov-src-st-badges { display:inline-flex; align-items:center; gap:6px; flex:0 0 auto; }
.ov-src-status .chip-closed { background:#e5e7eb; color:#4b5563; font-weight:700; }
.ov-src-checked { font-size:12px; font-weight:400; color:var(--muted); }
.ov-src-count { cursor: help; }
.ov-src-st-meta { display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; font-size:12px; }

/* 加载失败错误条（P1-2）：必须一眼可见，且配色在浅色/深色主题下都可读 */
.api-error-bar { display:none; }
.api-error-bar.show {
  display:flex; align-items:flex-start; justify-content:space-between; gap:10px;
  background:#7f1d1d; color:#fecaca; border:1px solid #ef4444; border-radius:8px;
  padding:10px 12px; margin-bottom:14px; font-size:12px; line-height:1.5;
}
.api-error-bar .api-error-txt { word-break:break-word; }
.api-error-bar .api-error-close {
  flex:0 0 auto; border:1px solid currentColor; background:transparent; color:inherit;
  border-radius:6px; cursor:pointer; font-size:12px; line-height:1; padding:2px 7px;
}
.api-error-bar .api-error-close:hover { opacity:.75; }

/* 模块二：国外驱动热点卡片 */
.ov-hs-list { display:flex; flex-direction:column; gap:14px; }
