td.td-fresh.fr-stale .fresh-age { color:var(--warn, #b45309); opacity:.85; }
td.td-fresh.fr-untracked, td.td-fresh.fr-unknown, td.td-fresh.fr-loading { color:var(--muted); }
/* 超时整行告警：淡琥珀底 + 左侧竖条（不改文字颜色，避免与行情红/绿混淆） */
tr:has(> td.td-fresh.fr-stale) > td { background:var(--warn-bg, #fef3c7); }
tr:has(> td.td-fresh.fr-stale) > td:first-child { box-shadow: inset 3px 0 0 var(--warn, #f59e0b); }

/* 卡片角标（股票卡片等非表格场景） */
.chip-fresh.fr-ok { color:var(--accent); }
.chip-fresh.fr-stale { background:var(--warn-bg, #fef3c7); color:var(--warn, #b45309); font-weight:700; }
.chip-fresh.fr-untracked, .chip-fresh.fr-unknown, .chip-fresh.fr-loading { color:var(--muted); opacity:.85; }
/* 独立于 fr-* 时效语义的两种小状态：未纳入刷新 / 内容有新版本 */
.chip-fresh.chip-untracked { color:var(--muted); opacity:.85; }
.chip-fresh.chip-new { color:var(--accent); border-color:var(--accent); }

