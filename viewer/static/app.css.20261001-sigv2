  background: rgba(180,120,20,.16); color: #96620a; white-space: nowrap; }

/* ============ 分支透视弹窗：可拖动 / 可最大化 / 与个股详情共存（2026-09-27） ============
   背景（王总实测）：在弹窗里点个股 chip，详情确实取到了数，但 .modal-overlay(z-index:9999 全屏遮罩)
   压在 #drawer(z-index:70) 之上 → 详情面板「看不见内容、点不到、也拖不动」；且弹窗自身无拖拽、
   表格被锁在 42vh，信息看不全。
   这里只针对 #branchModal 特化，**不改 .modal-overlay 基础样式** —— Cookie 弹窗 / 基金弹窗
   仍走原模态行为（全屏遮罩 + 居中）。 */

/* 1) 标题栏可拖动（与个股面板 .drawer-head 同手感） */
#branchModal .bm-head { cursor: move; user-select: none; touch-action: none; }
#branchModal .bm-head button { cursor: pointer; }
.branch-modal .bm-tools { display: flex; gap: 6px; flex: 0 0 auto; }
.branch-modal .bm-max { flex: 0 0 auto; width: 28px; height: 28px; border: 1px solid var(--border);
  background: var(--panel, #f6f8f9); color: var(--muted); border-radius: var(--r-sm);
  font-size: 13px; line-height: 1; cursor: pointer; }
.branch-modal .bm-max:hover { border-color: var(--accent, #0E7490); color: var(--accent, #0E7490); }
.branch-modal .bm-max.on { background: var(--accent, #0E7490); color: #fff; border-color: var(--accent, #0E7490); }

/* 2) 拖动 / 最大化后脱离 flex 居中，改自由定位（left/top 由 JS 写入） */
#branchModal.bm-floating .branch-modal,
#branchModal.bm-maxed .branch-modal { position: fixed; }

/* 3) 最大化：铺满视口，长名单表格同步放宽到 58vh */
#branchModal.bm-maxed .branch-modal {
  left: 12px !important; top: 56px !important;
  width: calc(100vw - 24px) !important;
  max-height: calc(100vh - 68px) !important;
}
#branchModal.bm-maxed .bm-tw { max-height: 58vh; }

/* 4) 让位于个股详情：遮罩转透明 + 不再拦截点击，弹窗整层降到详情面板之下（60 < 70） */
#branchModal.bm-behind { background: transparent; z-index: 60; pointer-events: none; }
#branchModal.bm-behind .branch-modal { pointer-events: auto; box-shadow: 0 10px 30px #0000003d; }

