.pol-jh { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.pol-jsec { font-size: 14px; }
.pol-jn { margin-left: auto; font-size: 11px; color: var(--muted, #64748b); white-space: nowrap; }
.pol-stance { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
.pol-stance.st-strong { color: #fff; background: var(--bull, #dc2626); }
.pol-stance.st-good { color: var(--bull, #dc2626); border: 1px solid color-mix(in srgb, var(--bull, #dc2626) 45%, transparent);
  background: color-mix(in srgb, var(--bull, #dc2626) 10%, transparent); }
.pol-stance.st-mixed { color: var(--muted, #64748b); border: 1px solid var(--border, rgba(148,163,184,.5));
  background: color-mix(in srgb, var(--muted, #64748b) 8%, transparent); }
.pol-stance.st-watch { color: #b45309; border: 1px solid color-mix(in srgb, #d97706 45%, transparent);
  background: color-mix(in srgb, #d97706 10%, transparent); }
.pol-jrs { margin-top: 7px; }
.pol-jr { font-size: 12.5px; line-height: 1.65; color: var(--text, inherit); opacity: .9; }
.pol-jm { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; margin-top: 7px; }
.pol-docs { margin-top: 14px; border: 1px dashed var(--border, rgba(148,163,184,.4)); border-radius: 10px; padding: 8px 12px; }
.pol-docs > summary { cursor: pointer; font-size: 13px; font-weight: 600; color: var(--muted, #64748b); user-select: none; }
.pol-docs > summary:hover { color: var(--accent, #0E7490); }
.pol-docs .pol-gt { margin-top: 12px; }

/* ---- 个股快讯研判卡（2026-09-30）：复用 pol-judge/pol-stance，补看跌档 + 明细分类徽章 ---- */
.pol-stance.st-bear { color: #fff; background: var(--bear, #16a34a); }
.ns-verdict { margin-top: 12px; }
.ns-cat { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 999px; white-space: nowrap; }
.ns-good { color: var(--bull, #dc2626); background: color-mix(in srgb, var(--bull, #dc2626) 10%, transparent); }
.ns-bad  { color: var(--bear, #16a34a); background: color-mix(in srgb, var(--bear, #16a34a) 10%, transparent); }
.ns-neutral { color: var(--muted, #64748b); background: color-mix(in srgb, var(--muted, #64748b) 12%, transparent); }


/* ===== 主动盯盘 / 个股预判（2026-10-01，watchdesk）===== */
.desk-tb tr { cursor: pointer; }
.desk-tb tr:hover td { background: color-mix(in srgb, var(--accent, #0E7490) 8%, transparent); }
.desk-tb tr.desk-sel td { background: color-mix(in srgb, var(--accent, #0E7490) 13%, transparent); }
.desk-mini { display: inline-block; width: 52px; height: 5px; border-radius: 3px; vertical-align: middle;
  margin-right: 6px; background: color-mix(in srgb, var(--border) 60%, transparent); overflow: hidden; }
.desk-mini i { display: block; height: 100%; background: var(--bull, #dc2626); }
.desk-n { font-size: 12px; }
.desk-fresh { color: #fff; background: #dc2626; font-size: 11px; padding: 1px 7px; border-radius: 999px; }
.desk-detail { margin-top: 14px; }
.desk-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; margin-top: 12px; }
.desk-tt { font-size: 12.5px; font-weight: 700; color: var(--muted, #64748b); margin: 10px 0 6px; }
.desk-tt-o { margin-top: 16px; }
.desk-list { border-left: 3px solid color-mix(in srgb, var(--border) 60%, transparent); padding-left: 10px; }
.desk-list.desk-r { border-left-color: #16a34a; }
.desk-list.desk-o { border-left-color: var(--bull, #dc2626); }
.desk-list .pol-jr { margin: 2px 0; }
.desk-w { font-size: 11.5px; color: var(--muted, #64748b); margin-left: 6px; }
.desk-w2 { font-size: 11px; color: var(--muted, #64748b); margin-left: 4px; }
.desk-t { color: var(--muted, #64748b); }
.desk-trig { color: #b45309; }
.desk-verdict { font-size: 13px; line-height: 1.7; }
.desk-fin { font-size: 12px; opacity: .9; }

/* ===== 盯盘表列宽收敛 + 清单空态（2026-10-01 watchdesk）=====
   7 列在 1440 视口下原本要横向滚约 270px，压名称/最近公告两列即可收回来。 */
.desk-tb th:nth-child(2), .desk-tb td:nth-child(2) {
  max-width: 92px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.desk-tb th:nth-child(7), .desk-tb td:nth-child(7) {
  max-width: 104px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.desk-tb th:nth-child(6), .desk-tb td:nth-child(6) { width: 76px; text-align: center; }
.desk-tb th:nth-child(1), .desk-tb td:nth-child(1) { width: 76px; }
/* 0 分时的清单空态：不空白，明确说明「为什么是 0」 */
.desk-empty { color: var(--muted, #64748b); opacity: .78; }
