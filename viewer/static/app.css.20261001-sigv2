  line-height: 1.7; border-top: 1px dashed var(--border); }

/* ---- 分支透视弹窗「对你的参考」推断块 ---- */
.branch-modal .bm-refer { margin-top: var(--sp-4); border: 1px solid var(--border);
  border-left: 3px solid var(--accent, #0E7490); border-radius: var(--r-md); background: var(--panel, #f6f8f9); }
