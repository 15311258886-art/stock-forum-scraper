/* ---- 分支透视弹窗「这个标签怎么读」解读块 ---- */
.branch-modal .bm-read { margin: var(--sp-3) 0 var(--sp-2); border: 1px solid var(--border);
  border-radius: var(--r-md); background: var(--panel, #f6f8f9); overflow: hidden; }
