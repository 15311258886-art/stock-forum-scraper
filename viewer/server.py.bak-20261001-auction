def _strategy_row_get(row, key, default=None):
    """安全读取 sqlite Row 的列：列不存在（旧库未 ALTER）时返回默认值，不抛 KeyError。"""
    try:
        keys = row.keys()
    except Exception:  # noqa: BLE001
        keys = []
    return row[key] if key in keys else default


