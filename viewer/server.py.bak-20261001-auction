def _player_index() -> dict:
    """name -> {tier, platform}，供各列表统一标注「来源渠道」。"""
    idx: dict[str, dict] = {}
    for r in DB.conn.execute("SELECT name, site, platform, tier, channel FROM players").fetchall():
        if not r["name"]:
            continue
        idx[r["name"]] = {
            "tier": r["tier"] or r["channel"],
            "platform": r["platform"] or r["site"],
